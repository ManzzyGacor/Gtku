{
  "name": "gtku",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Open-world pixel-art action RPG in 3D (Three.js + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && oxlint && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "assets": "tsx scripts/export-sheets.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
