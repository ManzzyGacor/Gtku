# Salin ke server/.env lalu isi nilainya DI SERVER. File .env tidak pernah di-commit.
# Nilai di bawah sengaja kosong.

# Connection string MongoDB (Atlas atau server sendiri). Wajib.
MONGODB_URI=
# Nama database. Opsional (bawaan: lentera_malam).
MONGODB_DB=
# Rahasia penanda access token (JWT HS256), minimal 32 karakter acak. Wajib.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Origin game yang boleh memanggil API. Opsional (bawaan: https://game.varesa.mom).
CORS_ORIGIN=
# Kode sekali pakai untuk mendaftarkan akun pengembang "manzzy". Opsional:
# kosong = nama itu tidak bisa didaftarkan lewat API (pakai `npm run set-role` di VPS).
DEV_SETUP_CODE=
